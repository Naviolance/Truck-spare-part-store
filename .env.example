# ---- Database ----
POSTGRES_USER=truckparts
POSTGRES_PASSWORD=truckparts_local_password
POSTGRES_DB=truckparts
POSTGRES_PORT=5432
DATABASE_URL="postgresql://truckparts:truckparts_local_password@localhost:5432/truckparts?schema=public"

# ---- Backend ----
BACKEND_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string_in_real_env
JWT_ACCESS_EXPIRES_IN=5m
# Used for the Notch Pay callback URL and the production CORS allowlist
# (main.ts only trusts this exact origin when NODE_ENV=production).
FRONTEND_URL=http://localhost:3000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Object storage (MinIO - local S3-compatible storage) ----
MINIO_ROOT_USER=truckparts_admin
MINIO_ROOT_PASSWORD=truckparts_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=truckparts-media

# ---- Mail (Mailhog - local fake SMTP for testing emails) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAILHOG_WEB_PORT=8025

# ---- Payments (Notch Pay - https://business.notchpay.co -> Developers -> API Keys) ----
# Public key: used to initialize/verify payments (payments.service.ts).
NOTCHPAY_PUBLIC_KEY=
# Private key: currently unused by the app, but issued alongside the public
# key - kept here so it's not lost/forgotten when refund support is added.
NOTCHPAY_PRIVATE_KEY=
# Webhook signing secret, from the same dashboard's Webhooks section - HMAC-
# verifies that POST /payments/webhooks/notchpay really came from Notch Pay.
NOTCHPAY_WEBHOOK_HASH=
