# ---- Database ----
POSTGRES_USER=truckparts
POSTGRES_PASSWORD=truckparts_local_password
POSTGRES_DB=truckparts
POSTGRES_PORT=5432
DATABASE_URL="postgresql://truckparts:truckparts_local_password@localhost:5432/truckparts?schema=public"

# ---- Backend ----
BACKEND_PORT=4000
JWT_SECRET=change_me_to_a_long_random_string_in_real_env
JWT_EXPIRES_IN=7d

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Object storage (MinIO - local S3-compatible storage) ----
MINIO_ROOT_USER=truckparts_admin
MINIO_ROOT_PASSWORD=truckparts_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=truckparts-media

# ---- Mail (Mailhog - local fake SMTP for testing emails) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAILHOG_WEB_PORT=8025

# ---- Payments (fill in once we integrate a real provider) ----
PAYMENT_PROVIDER=fake_local
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_SECRET=
