# ---- Database ----
POSTGRES_USER=truckparts
POSTGRES_PASSWORD=truckparts_local_password
POSTGRES_DB=truckparts
POSTGRES_PORT=5433
DATABASE_URL="postgresql://truckparts:truckparts_local_password@localhost:5433/truckparts?schema=public"

# ---- Backend ----
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
JWT_SECRET=change_me_to_a_long_random_string_in_real_env
JWT_ACCESS_EXPIRES_IN=5m

# Rate limiting. TRUST_PROXY = how many proxies sit in front of the backend
# (unset = loopback only, right for local dev). In production, open
# /api/backend/health and raise/lower it until "clientIp" shows YOUR real IP.
TRUST_PROXY=
# Shared secret the Next.js server sends on its own SSR/sitemap requests so
# they aren't rate limited as one big "visitor". Same value in the frontend.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# Read-only demo accounts (comma-separated emails): they can open every admin
# page but every change is rejected. UNSET = admin@truckparts.local (what
# production uses). EMPTY, as here = no demo accounts, so the seeded admin
# is fully editable for local development.
DEMO_ACCOUNT_EMAILS=

# ---- Frontend ----
# FRONTEND_URL is read by the BACKEND (CORS, reset links).
FRONTEND_URL=http://localhost:3000
# Optional: where the backend reaches the frontend to refresh catalog pages after admin edits
# (POST /api/revalidate). Defaults to FRONTEND_URL; set it when the apps talk over a private network.
FRONTEND_INTERNAL_URL=
# The NEXT_PUBLIC_* values below are NOT read from this root file: the
# frontend runs in apps/frontend and only loads its own apps/frontend/.env.local.
# Locally the defaults already point at localhost; in production they're set
# in Vercel. Listed here so every variable is documented in one place.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: show the read-only demo login on the login page.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
# Business WhatsApp in international format, digits only (e.g. 237654321100).
NEXT_PUBLIC_WHATSAPP_NUMBER=237654432641
# Google Search Console ownership token (the content="..." value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Umami analytics (cookieless). Empty = no analytics.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_DOMAINS=
# Google Analytics 4 measurement ID (G-XXXXXXX). Optional: when set, the cookie banner asks for consent
# and GA loads only after "Accepter". Leave empty for no GA (Umami above needs no consent).
NEXT_PUBLIC_GA_ID=
# The frontend also needs INTERNAL_API_KEY (same value as the backend's,
# above) so its server-side page renders aren't rate limited.

# ---- Object storage (MinIO - local S3-compatible storage) ----
MINIO_ROOT_USER=truckparts_admin
MINIO_ROOT_PASSWORD=truckparts_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=truckparts-media
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1

# ---- Mail (Mailhog - local fake SMTP for testing emails) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAILHOG_WEB_PORT=8025
MAIL_FROM=no-reply@truckparts.local
# MAIL_USER / MAIL_PASSWORD are only needed for a real SMTP provider -
# Mailhog (used locally) doesn't require authentication.
MAIL_USER=
MAIL_PASSWORD=

# ---- Orders ----
# Unpaid orders release their reserved stock after this long without payment
# (checked every 5 minutes). Cash-at-pickup orders get longer.
ORDER_PAYMENT_TTL_MINUTES=60
CASH_PICKUP_TTL_HOURS=72
# Where new-order / new-part-request / payment-problem alerts go
# (comma-separated). Empty = no admin emails.
ADMIN_NOTIFICATION_EMAIL=

# ---- Payments ----
# Online payment provider adapter (apps/backend/src/payments/providers).
# Empty = cash at pickup only; checkout hides the online option.
PAYMENT_PROVIDER=
# Notch Pay (only read when PAYMENT_PROVIDER=notchpay; sandbox keys at business.notchpay.co)
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=

# ---- Error monitoring (Sentry, free tier). Empty = off. ----
# Backend (Railway):
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Frontend (Vercel): DSN of the frontend project, plus build-time values for
# readable stack traces (source maps). Leave the build values empty to skip.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
