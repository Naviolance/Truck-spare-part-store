# ---- Database ----
POSTGRES_USER=truckparts
POSTGRES_PASSWORD=truckparts_local_password
POSTGRES_DB=truckparts
POSTGRES_PORT=5433
DATABASE_URL="postgresql://truckparts:truckparts_local_password@localhost:5433/truckparts?schema=public"

# ---- Backend ----
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
JWT_SECRET=change_me_to_a_long_random_string_in_real_env
JWT_ACCESS_EXPIRES_IN=5m

# Read-only demo accounts (comma-separated emails): they can open every admin
# page but every change is rejected. UNSET = admin@truckparts.local (what
# production uses). EMPTY, as here = no demo accounts, so the seeded admin
# is fully editable for local development.
DEMO_ACCOUNT_EMAILS=

# ---- Frontend ----
# FRONTEND_URL is read by the BACKEND (CORS, reset links).
FRONTEND_URL=http://localhost:3000
# The NEXT_PUBLIC_* values below are NOT read from this root file: the
# frontend runs in apps/frontend and only loads its own apps/frontend/.env.local.
# Locally the defaults already point at localhost; in production they're set
# in Vercel. Listed here so every variable is documented in one place.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: show the read-only demo login on the login page.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# ---- Object storage (MinIO - local S3-compatible storage) ----
MINIO_ROOT_USER=truckparts_admin
MINIO_ROOT_PASSWORD=truckparts_local_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=truckparts-media
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_REGION=us-east-1

# ---- Mail (Mailhog - local fake SMTP for testing emails) ----
MAIL_HOST=localhost
MAIL_PORT=1025
MAILHOG_WEB_PORT=8025
MAIL_FROM=no-reply@truckparts.local
# MAIL_USER / MAIL_PASSWORD are only needed for a real SMTP provider -
# Mailhog (used locally) doesn't require authentication.
MAIL_USER=
MAIL_PASSWORD=

# ---- Payments (Notch Pay - get sandbox keys at business.notchpay.co) ----
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_WEBHOOK_HASH=
