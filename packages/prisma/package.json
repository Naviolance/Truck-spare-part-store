{
  "name": "@truckparts/prisma",
  "version": "0.1.0",
  "private": true,
  "main": "generated/client/index.js",
  "types": "generated/client/index.d.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx seed.ts",
    "admin:promote": "dotenv -e ../../.env -- tsx scripts/promote-admin.ts",
    "launch:reset": "dotenv -e ../../.env -- tsx scripts/launch-reset.ts",
    "photos:check": "dotenv -e ../../.env -- tsx scripts/check-photos.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@types/bcrypt": "^5.0.2",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
