// TruckParts — single-vendor e-commerce data model (V1)
// No multi-vendor / store / commission entities in this version.

generator client {
  provider = "prisma-client-js"
  output   = "generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductCondition {
  NEW
  USED
  RECONDITIONED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  CART
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  PAYMENT_FAILED
  EXPIRED // never paid within the time limit; reserved stock was released
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  defaultShippingAddress String?
  defaultShippingCity    String?
  defaultShippingPhone   String?
  role         UserRole @default(CUSTOMER)
  // Consent to offers / new-stock alerts (WhatsApp or e-mail). Off unless the
  // customer ticked it; the date is when they last said yes.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  // Set when an admin deletes an account that has orders: the row stays so
  // order history holds, but every personal field is erased.
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart                Cart?
  orders              Order[]
  reviews             Review[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  productRequests     ProductRequest[]

  @@map("users")
}

// One row per login session/device. The token is stable for the session's
// whole lifetime — nothing rotates it — so there is no possible race
// between concurrent requests touching the same session (the entire prior
// design's bug class). Session validity is instead governed by two
// independent checks, both enforced server-side on every touch:
// lastActiveAt (sliding — must be touched at least this often) and
// expiresAt (a fixed absolute outer cap, regardless of activity).
// tokenHash is stored, never the plaintext, so a database leak alone can't
// be used to impersonate a session.
model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// Same pattern as RefreshToken — hashed token, short expiry, single-use via
// usedAt — so a DB leak alone can't be used to reset anyone's password.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Catalog: categories, brands, vehicles
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  nameFr    String? // French name for /fr pages; falls back to `name` when unset
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryToCategory")
  products  Product[]
  createdAt DateTime   @default(now())

  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("brands")
}

model Vehicle {
  id           String  @id @default(uuid())
  manufacturer String
  model        String
  yearStart    Int
  yearEnd      Int?
  engine       String?

  compatibilities ProductCompatibility[]

  createdAt DateTime @default(now())

  @@index([manufacturer, model])
  @@map("vehicles")
}

// ---------------------------------------------------------------------------
// Products
// ---------------------------------------------------------------------------

model Product {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique
  description    String
  descriptionFr  String? // French description; falls back to `description` when unset
  price          Decimal          @db.Decimal(12, 2)
  quantity       Int              @default(0)
  condition      ProductCondition
  conditionNotes String? // required in app logic when condition = USED
  status         ProductStatus    @default(DRAFT)
  partNumber     String? // OEM / manufacturer part number
  crossReference String[]         @default([]) // alternative part numbers
  searchHits     Int              @default(0) // incremented each time this product appears in a search-with-query result — powers "most searched"
  // Everything a customer can search a product by, in one lower-case,
  // accent-free string: name, descriptions, brand, category, compatible
  // trucks, part/cross-reference numbers (as typed and punctuation-free).
  // Written ONLY by database triggers (migration *_product_search_text) —
  // never set it from code. @ignore keeps it out of Prisma Client entirely.
  searchText     String           @default("") @ignore

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  images        ProductImage[]
  compatibility ProductCompatibility[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  reviews       Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([searchHits])
  // Trigram index: makes `searchText LIKE '%word%'` and typo matching (<%)
  // index lookups instead of a scan of every product. Declared here so
  // Prisma migrations never drop it.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_search_text_trgm_idx")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("product_images")
}

model ProductCompatibility {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleId])
  @@map("product_compatibility")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
  createdAt DateTime   @default(now())

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        OrderStatus @default(PAYMENT_PENDING)
  subtotal      Decimal     @db.Decimal(12, 2)
  shippingTotal Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  shippingAddress String
  shippingCity    String
  shippingPhone   String

  items    OrderItem[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([status, createdAt]) // expiry job: oldest PAYMENT_PENDING orders
  @@index([createdAt]) // admin order list: newest first, one page at a time
  @@map("orders")
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id     String     @id @default(uuid())
  code   String     @unique
  type   CouponType
  value  Decimal    @db.Decimal(12, 2) // percentage (0-100) or fixed FCFA amount, depending on type
  active Boolean    @default(true)

  minOrderTotal Decimal?  @db.Decimal(12, 2)
  maxUses       Int? // null = unlimited
  usedCount     Int       @default(0)
  expiresAt     DateTime?

  orders Order[]

  createdAt DateTime @default(now())

  @@map("coupons")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot fields — never trust live product price after order is placed
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

// One row per payment ATTEMPT, not per order: a customer can retry a failed
// or abandoned online payment, and each attempt gets its own unique
// `reference` (what we send the provider) so a late result for an old
// attempt can never be confused with the current one.
model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  order                 Order         @relation(fields: [orderId], references: [id])
  provider              String // "cash" or a payment provider adapter name
  reference             String?       @unique // our per-attempt reference sent to the provider
  providerTransactionId String?       @unique
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(PENDING)
  rawPayload            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Product requests — a customer asking for a part that isn't listed yet.
// Purely a lead for the admin to act on manually (source the part, list it,
// or decline); nothing here automatically creates a Product.
// ---------------------------------------------------------------------------

enum ProductRequestStatus {
  OPEN
  IN_PROGRESS
  FULFILLED
  DECLINED
}

model ProductRequest {
  id          String               @id @default(uuid())
  // Null for guest requests. SetNull (not Cascade): a request is a sales
  // lead for the business, so it outlives the account that made it.
  userId      String?
  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  // How to reach the customer — required by the API for new requests;
  // nullable only because requests made before guests were allowed have none.
  contactName        String?
  contactPhone       String?
  contactEmail       String?
  contactViaWhatsApp Boolean              @default(true)
  description String
  partNumber  String?
  vehicleInfo String?
  status      ProductRequestStatus @default(OPEN)
  adminNote   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@map("product_requests")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Insights — daily totals for the admin dashboard. No personal data: no IP,
// no user, just what was searched / which WhatsApp button, and how often.
// One row per day+term (or day+source), so the tables stay small.
// ---------------------------------------------------------------------------

model SearchStat {
  day         DateTime @db.Date
  term        String // lower-cased, whitespace-collapsed, max 100 chars
  searches    Int      @default(0)
  zeroResults Int      @default(0) // of those, how many found nothing

  @@id([day, term])
  @@map("search_stats")
}

model WhatsAppClickStat {
  day    DateTime @db.Date
  source String // which button: "product", "footer", "floating"... (whitelisted)
  clicks Int      @default(0)

  @@id([day, source])
  @@map("whatsapp_click_stats")
}
